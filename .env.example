# PortIOPay Admin Dashboard — environment template
# Copy to .env.local for local development: cp .env.example .env.local

# Application
NODE_ENV=development

# NextAuth — https://next-auth.js.org/configuration/options
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Data stores (defaults match local Docker Compose if used)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admin_dashboard
REDIS_URL=redis://localhost:6379
